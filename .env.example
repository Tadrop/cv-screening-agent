# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── OpenAI (embeddings only) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=buildright-jd-index

# ─── Gmail OAuth 2.0 ──────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console → APIs & Services → Credentials
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ─── Google Sheets (Service Account) ─────────────────────────────────────────
# Download service_account.json from Google Cloud Console → IAM & Admin → Service Accounts
GOOGLE_SERVICE_ACCOUNT_PATH=service_account.json

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
# Default hiring manager — can be overridden per-role in roles table
SLACK_HIRING_MANAGER_USER_ID=U0123456789

# ─── Application ──────────────────────────────────────────────────────────────
DB_PATH=data/candidates.db
BRIEFS_DIR=data/briefs
ATTACHMENTS_DIR=data/attachments
LOG_LEVEL=INFO

# Inbox polling cadence (minutes)
POLL_INTERVAL_MINUTES=10

# Score threshold for Slack standout alert
STANDOUT_SCORE_THRESHOLD=85

# GDPR retention window (days)
GDPR_RETENTION_DAYS=90

# Claude model
CLAUDE_MODEL=claude-sonnet-4-6
